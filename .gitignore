models/
*.ckpt
*.h5

# Predictor Python environment (isolated stack for TF+PyTorch legacy pins)
.venv-predictors/

# Raw predictor intermediate VCFs (parsed into results/predictions/*.tsv)
results/predictions/*_raw.vcf
results/predictions/*_raw

# Runtime outputs (kept out of git until frozen and hashed for release)
results/raw_predictions/
results/intermediate/
results/*.log

# Jupyter
.ipynb_checkpoints/
*.ipynb  # keep repo script-first; convert notebooks to scripts before commit

# Smoke-test artefacts (mechanics test only, not scientific outputs)
results/smoke/
